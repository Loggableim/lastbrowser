# Maintainer: LastBrowser <hello@lastbrowser.com>
pkgname=lastbrowser-bin
pkgver=0.1.56
pkgrel=1
pkgdesc='LastBrowser Linux-Vorschau: Browser für Windows und Linux mit KI-System Sidekick'
arch=('x86_64')
url='https://lastbrowser.com'
license=('LicenseRef-LastBrowser')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk3'
  'libcups'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'python'
  'systemd-libs'
)
optdepends=('xdg-utils: open http links from other applications')
options=('!strip' '!debug')
source=(
  "https://github.com/Loggableim/lastbrowser/releases/download/v${pkgver}/Lastbrowser-${pkgver}-x64.tar.gz"
  'lastbrowser.desktop'
  'lastbrowser.png'
  'LICENSE.LastBrowser'
)
sha256sums=(
  'fe34e0d6ccf03d889c7eb2f55cd56ff7b52d1653f21ba7c82b6bc9234606d54e'
  '0f1c92f3338dc1666a394f3c65a9680cb0367fcee4e8f2a8a6b975055260e0ed'
  'c3536243206898692c53e2c5c18a3ebc530da4a8f4b54c7f527150ce9e1dd2bb'
  '8c1d5872aa84fb1ead2bc32f2d707f78411d8c43d24cc087736b01d2eb6be8f8'
)

package() {
  install -dm755 "${pkgdir}/usr/lib/lastbrowser"
  cp -a "Lastbrowser-${pkgver}-x64/." "${pkgdir}/usr/lib/lastbrowser/"
  chmod 755 "${pkgdir}/usr/lib/lastbrowser/Lastbrowser"
  if [[ -f "${pkgdir}/usr/lib/lastbrowser/chrome-sandbox" ]]; then
    chmod 4755 "${pkgdir}/usr/lib/lastbrowser/chrome-sandbox"
  fi

  install -dm755 "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/lastbrowser" << 'LAUNCH'
#!/bin/sh
exec /usr/lib/lastbrowser/Lastbrowser "$@"
LAUNCH
  chmod 755 "${pkgdir}/usr/bin/lastbrowser"

  install -Dm644 "${srcdir}/lastbrowser.desktop" \
    "${pkgdir}/usr/share/applications/lastbrowser.desktop"
  install -Dm644 "${srcdir}/lastbrowser.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/lastbrowser.png"
  install -Dm644 "${srcdir}/LICENSE.LastBrowser" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.LastBrowser"
}
