# Free-Tier Router M1 — never commit real secrets
REDIS_URL=redis://127.0.0.1:6379/0
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=
# Model mapping (Ollama Cloud). Override if Cid renames.
MODEL_LIGHT=nemotron-3-nano
MODEL_MID=gpt-oss:120b
MODEL_MID_ALT=glm-5.3-flash
MODEL_HEAVY=deepseek-v4.1-flash
# Daily budget in EUR (placeholder; Cid sets amount). Soft limit only in M1.
DAILY_BUDGET_EUR=0
CONFIDENCE_THRESHOLD=0.6
HOST=127.0.0.1
PORT=8088
