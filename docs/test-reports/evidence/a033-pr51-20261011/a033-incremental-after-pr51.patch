+
+def get_codex_model_context_length(model_id: str) -> Optional[int]:
+    """Read exact OAuth catalog metadata; never substitute OpenAI API limits."""
+    model = str(model_id or "").strip()
+    prefix = "@openai-codex:"
+    if model.startswith(prefix):
+        model = model[len(prefix):]
+    if not model or model.startswith("@"):
+        return None
+    codex_home = os.getenv("CODEX_HOME", "").strip() or str(Path.home() / ".codex")
+    try:
+        raw = json.loads((Path(codex_home).expanduser() / "models_cache.json").read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    entries = raw.get("models") if isinstance(raw, dict) else None
+    for entry in entries if isinstance(entries, list) else []:
+        if not isinstance(entry, dict) or entry.get("slug") != model:
+            continue
+        length = entry.get("context_window")
+        return length if type(length) is int and 1 <= length <= 16000000 else None
+    return None
+
 DEFAULT_CODEX_MODELS: List[str] = [
