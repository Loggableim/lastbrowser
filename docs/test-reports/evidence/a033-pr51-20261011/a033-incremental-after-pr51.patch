diff --git a/services/sidekick/tests/test_a033_catalog_context.py b/services/sidekick/tests/test_a033_catalog_context.py
new file mode 100644
index 0000000..daa2bcb
--- /dev/null
+++ b/services/sidekick/tests/test_a033_catalog_context.py
@@ -0,0 +1,73 @@
+"""Exact context metadata regression; runs without optional pytest tooling."""
+import unittest
+import json
+import tempfile
+from pathlib import Path
+from unittest.mock import patch
+
+from runtime.independent.scoped_models import public_catalog
+
+
+class CatalogContextTests(unittest.TestCase):
+    def test_fixed_and_picker_probes_keep_same_connection_evidence(self):
+        from runtime.independent.runner import discover_public_model_catalog
+        raw = {"groups": [{"provider_id": "xiaomi", "models": [
+            {"id": "mimo-v2.6-flash", "context_length": 1048576}]}]}
+        accounts = {"providers": [{"id": "xiaomi", "has_key": True}]}
+        with patch("web.api.config.get_available_models", return_value=raw), \
+                patch("web.api.config.get_config", return_value={}), \
+                patch("web.api.providers.get_providers", return_value=accounts), \
+                patch("runtime.independent.capabilities.public_inventory", return_value={}) as inventory:
+            fixed = discover_public_model_catalog(None, include_capabilities=False)
+            inventory.assert_not_called()
+            picker = discover_public_model_catalog(None, include_capabilities=True)
+            self.assertTrue(fixed["groups"][0]["configured"])
+            self.assertEqual(fixed["groups"], picker["groups"])
+            self.assertNotIn("capabilityInventory", fixed)
+            self.assertIn("capabilityInventory", picker)
+
+    def catalog(self, provider="xiaomi", model="mimo-v2.6-flash", configuration=None):
+        return public_catalog({"groups": [{"provider_id": provider,
+            "models": [{"id": model}]}]}, {}, configuration or {})["groups"][0]["models"][0]
+
+    @patch("runtime.models_dev.lookup_models_dev_context", return_value=1048576)
+    def test_live_id_only_catalog_retains_exact_context(self, lookup):
+        row = self.catalog(model="@xiaomi:mimo-v2.6-flash")
+        self.assertEqual(row["contextLength"], 1048576)
+        lookup.assert_called_once_with("xiaomi", "mimo-v2.6-flash")
+
+    @patch("runtime.models_dev.lookup_models_dev_context", return_value=None)
+    def test_unknown_context_stays_unknown(self, lookup):
+        self.assertNotIn("contextLength", self.catalog(model="unknown-fixture"))
+
+    @patch("runtime.models_dev.lookup_models_dev_context", return_value=True)
+    def test_invalid_metadata_is_rejected(self, lookup):
+        self.assertNotIn("contextLength", self.catalog())
+
+    @patch("runtime.models_dev.lookup_models_dev_context", return_value=1048576)
+    def test_explicit_context_wins(self, lookup):
+        row = self.catalog(configuration={"model": {"provider": "xiaomi",
+            "default": "mimo-v2.6-flash", "context_length": 131072}})
+        self.assertEqual(row["contextLength"], 131072)
+        lookup.assert_not_called()
+
+    @patch("runtime.models_dev.lookup_models_dev_context", return_value=1050000)
+    def test_codex_does_not_inherit_direct_api_context(self, lookup):
+        with patch("cli.codex_models.get_codex_model_context_length", return_value=None):
+            self.assertNotIn("contextLength", self.catalog("openai-codex", "unknown-fixture"))
+        lookup.assert_not_called()
+
+    def test_codex_exact_local_context_and_unknown_model(self):
+        from cli.codex_models import get_codex_model_context_length
+        with tempfile.TemporaryDirectory() as home, patch.dict("os.environ", {"CODEX_HOME": home}):
+            Path(home, "models_cache.json").write_text(json.dumps({"models": [
+                {"slug": "gpt-fixture", "context_window": 272000},
+                {"slug": "invalid-fixture", "context_window": True}]}), encoding="utf-8")
+            self.assertEqual(get_codex_model_context_length("@openai-codex:gpt-fixture"), 272000)
+            self.assertIsNone(get_codex_model_context_length("gpt-fixture-new"))
+            self.assertIsNone(get_codex_model_context_length("invalid-fixture"))
+            self.assertEqual(self.catalog("openai-codex", "gpt-fixture")["contextLength"], 272000)
+
+
+if __name__ == "__main__":
+    unittest.main()
