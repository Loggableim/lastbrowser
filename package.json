{
  "name": "lastbrowser",
  "version": "0.1.44",
  "private": true,
  "description": "Lastbrowser desktop browser shell with Sidekick integration.",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "pnpm --filter @lastbrowser/desktop run dev",
    "build": "pnpm --filter @lastbrowser/desktop run build",
    "test": "pnpm --filter @lastbrowser/desktop run test",
    "test:run": "pnpm --filter @lastbrowser/desktop run test:run",
    "package:win": "pnpm --filter @lastbrowser/desktop run package:win",
    "release:win": "pnpm --filter @lastbrowser/desktop run package:win:publish",
    "verify:store": "powershell -ExecutionPolicy Bypass -File scripts/verify-store-readiness.ps1"
  },
  "devDependencies": {
    "js-yaml": "^4.1.1"
  }
}
