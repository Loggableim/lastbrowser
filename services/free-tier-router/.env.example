# Free-Tier Router M1 — never commit real secrets
REDIS_URL=redis://127.0.0.1:6379/0
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=
# Model + reasoning per tier (Ollama Cloud, Cid). think: off→false, low→"low"
MODEL_LIGHT=nemotron-3-nano
REASONING_LIGHT=off
MODEL_MID=gpt-oss:20b
REASONING_MID=off
MODEL_HEAVY=glm-5.3-flash
REASONING_HEAVY=low
# Daily budget in EUR (placeholder; Cid sets amount). Soft limit only in M1.
DAILY_BUDGET_EUR=0
CONFIDENCE_THRESHOLD=0.6
HOST=127.0.0.1
PORT=8088
