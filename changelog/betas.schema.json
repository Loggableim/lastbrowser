{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastbrowser.com/schemas/beta-changelog.schema.json",
  "title": "LastBrowser daily beta changelog",
  "description": "Machine-readable changelog for unsigned daily beta builds. Stable releases stay in CHANGELOG.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "releases"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "channel": {
      "const": "beta"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "label", "date", "build", "commit", "signed", "sinceStable", "changes"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "label": {
          "type": "string",
          "pattern": "^Beta [0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "signed": {
          "type": "boolean"
        },
        "sinceStable": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": {
          "enum": ["feature", "fix", "improvement", "security", "docs", "build"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
